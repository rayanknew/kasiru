# API keys of cloud providers (names are referenced from kasiru.json "key": "...")
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Keys your own programs use to call Kasiru (referenced from "clients": {"...": {"key_env": "..."}})
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KASIRU_KEY_AGENT=
KASIRU_KEY_SCRIPTS=
KASIRU_KEY_ADMIN=
